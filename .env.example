# Clave de Groq. Solo la lee el servidor (app/api/chat/route.ts).
# No uses el prefijo NEXT_PUBLIC_: ese prefijo la incrustaría en el JavaScript del navegador.
GROQ_API_KEY=

# Modelo enviado a https://api.groq.com/openai/v1/chat/completions
# El enunciado nombra qwen/qwen3.6-27b en el brief y, más abajo, "Llama 3" sin id.
# Decisión documentada en README.md y ASSUMPTIONS.md: el valor por defecto es el id explícito del brief.
# Si Groq rechaza ese id, prueba el sucesor publicado en su página de deprecaciones: qwen/qwen3.8-27b
GROQ_MODEL=qwen/qwen3.6-27b

# auto: llama a Groq si GROQ_API_KEY tiene valor; si no, responde en modo demostración.
# mock: siempre demostración, aunque exista clave.
# live: exige clave y no inventa una respuesta si falta.
CHAT_MODE=auto

# Opcional. Espera artificial del modo demostración, en milisegundos, para ver el estado "Pensando…".
# No representa latencia de Groq. 0 en pruebas.
MOCK_LATENCY_MS=0
